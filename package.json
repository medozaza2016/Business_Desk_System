{
  "name": "challenger-quotation-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply challenger-quotation-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply challenger-quotation-db --remote",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
